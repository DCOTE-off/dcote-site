APP_NAME=DCOTE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# DCOTE — внешние сервисы
DCOTE_VIDEO_BASE_URL=https://video.dcote.net
DCOTE_METRICS_BASE_URL=https://metrics-api.dcote.net

# База данных
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dcote
DB_USERNAME=sail
DB_PASSWORD=password

# Хранилище
FILESYSTEM_DISK=local

# Логирование
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Кэш / сессии / очереди
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Почта (в деве — Mailpit-перехватчик; в проде — реальный SMTP в серверном .env)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@dcote.net"
MAIL_FROM_NAME="DCOTE Official"

# Cloudflare Turnstile (ключи ниже — официальные тестовые)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sanctum
SANCTUM_STATEFUL_DOMAINS=

# Бэкапы (spatie/laravel-backup, отдельный бакет Cloudflare R2)
BACKUP_NAME=MainDcoteSite
BACKUP_DISK=backups
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_DEFAULT_REGION=auto
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=

# Docker (build args)
WWWUSER=1000
WWWGROUP=1000
